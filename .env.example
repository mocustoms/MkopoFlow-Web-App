# Local development — copy to .env
# Origin only (no trailing slash, no /api suffix). Routes add /api/v1/...
VITE_API_URL=http://localhost:3000

# Railway web service — available at BUILD time, then redeploy after changes
# VITE_API_URL=https://mkopoflow-backend-production.up.railway.app
#
# Backend service must allow this app's origin (Railway → MkopoFlow-Backend variables):
# CORS_ORIGINS=https://mkopoflow-web-app-production.up.railway.app
